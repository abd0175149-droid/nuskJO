APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# E27: بلا قيمة = Secure حين يبدأ APP_URL بـ https، ولا قيد للتطوير المحلي على http. false يعطّله صراحة
# SESSION_SECURE_COOKIE=
# SESSION_SAME_SITE=lax

# التحقق بخطوتين للموظفين (E27). التسجيل خلف العلم staff_mfa، والتحقق المعزّز خلف step_up (WA_FEATURE_*)
# MFA_ENFORCE=off                 # off ثم warn (شريط تنبيه) ثم on (لا صفحة غير «الأمان» حتى يسجّل)
# MFA_ENFORCE_FROM=               # تاريخ بدء on بتوقيت عمّان، مثل 2026-11-15
# MFA_CHALLENGE=on                # off منفذ طوارئ يعطّل التحدّي للجميع (يُدقَّق، ويُكتب في CHANGELOG)
# MFA_ISSUER=                     # الاسم في تطبيق المصادقة (الافتراضي APP_NAME)
# STEPUP_TTL=900                  # نافذة تأكيد الهوية قبل الأفعال الحساسة (ثوانٍ)
# PASSWORD_MIN_LENGTH=8           # قرار المالك: 10
# PASSWORD_LETTERS_AND_NUMBERS=false
# IDLE_USER_DAYS=60
# IDLE_ADMIN_NUMBER_DAYS=90
# WA_FEATURE_STAFF_MFA=
# WA_FEATURE_STEP_UP=
# WA_FEATURE_ADMIN_NUMBER_MFA=
# WA_FEATURE_IDLE_REPORT=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# البث اللحظي (Reverb، E28). المتصفح على VITE_REVERB_* (تُخبز في البناء)، والخادم ينشر داخل الحاوية.
# REVERB_APP_KEY= / REVERB_APP_SECRET= / REVERB_APP_ID=
# REVERB_HOST=nuskjo.grade.sbs      # المضيف العام (المتصفح وVITE_REVERB_HOST)
# REVERB_PORT=443
# REVERB_SCHEME=https
# REVERB_PUBLISH_HOST=127.0.0.1     # نشر الخادم داخل الحاوية؛ بلا قيمة: REVERB_HOST كما كان
# REVERB_PUBLISH_PORT=8080
# REVERB_PUBLISH_SCHEME=http
# REVERB_PUBLISH_CONNECT_TIMEOUT=1  # ثوانٍ؛ Reverb متعطّل لا يعلّق طلباً ولا وظيفة
# REVERB_PUBLISH_TIMEOUT=2
# REVERB_ALLOWED_ORIGINS=           # مضيفات مفصولة بفواصل؛ فارغ = مضيف APP_URL، و'*' للتراجع المؤقت فقط
# REVERB_APP_MAX_CONNECTIONS=200
# REVERB_APP_ACCEPT_CLIENT_EVENTS_FROM=none
# REVERB_APP_RATE_LIMITING_ENABLED=true
# REVERB_APP_RATE_LIMIT_MAX_ATTEMPTS=60
# REVERB_APP_RATE_LIMIT_DECAY_SECONDS=60
# REVERB_APP_RATE_LIMIT_TERMINATE=true
# BROADCAST_AUTH_PER_MINUTE=60      # /broadcasting/auth لكل مستخدم (كل تنقّل يعيد الاشتراك)
# BROADCAST_AUTH_PER_IP_MINUTE=120
# VITE_REVERB_APP_KEY= / VITE_REVERB_HOST= / VITE_REVERB_PORT= / VITE_REVERB_SCHEME=

# Firebase (إشعارات الجهاز)
FIREBASE_CREDENTIALS=storage/app/firebase-auth.json
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=

# واتساب (Cloud API الرسمية). الأسرار تُحفظ من صفحة إعدادات الواتساب أو هنا (هنا الأولوية).
# WA_GRAPH_VERSION=v25.0          # إصدار الطلبات؛ تواريخ النهاية في app/Services/WhatsApp/GraphVersions.php
# WA_WEBHOOK_VERSION=v25.0        # الإصدار المضبوط في لوحة ميتا للويبهوك (للتنبيه قبل نهايته)
# WA_APPSECRET_PROOF=false        # true قبل تفعيل «Require App Secret» في لوحة ميتا بأسبوع
# WA_GRAPH_COUNTER_STORE=file     # عدّادات النداءات والإثبات (whatsapp:doctor)؛ file داخل حجم التخزين
# WA_AUTOSUSPEND_CODES=368        # إيقاف الإرسال آلياً؛ 131031 قد يعني PIN خاطئاً فينبّه فقط
# WA_OPAQUE_PREFIX=nj             # بادئة رقم الصف في biz_opaque_callback_data (دفتر الإرسال)
# WA_SEND_RETRY_MAX_SLEEP=8       # مجموع انتظار الإعادات لرسالة واحدة (ثوانٍ)
# WA_WABA_ID=                     # معرّف حساب واتساب للأعمال؛ قارنه بالمكتشف في الإعدادات قبل فرض السياج
# WA_WEBHOOK_LOG_MODE=all         # failures: حفظ جسم الويبهوك المشفّر عند الخطأ وحده (ضغط كتابة)
# WA_WEBHOOK_MAX_BYTES=4194304    # حد جسم الويبهوك (لا يقل عن 3MB)، مساوٍ لكتلة nginx
# WA_FEATURE_INBOUND_EVENT_LOG=   # حفظ الويبهوك قبل الإقرار وإعادته (يُبدَّل من الإعدادات أيضاً)
# WA_FEATURE_WEBHOOK_FENCE_ENFORCE= # رفض حمولة الحساب أو الرقم الغريب فعلاً (بعد أسبوع تسجيل نظيف)
# WA_FEATURE_WA_BLOCK=            # الحظر الرسمي من الصندوق وصفحة المحظورين (يُبدَّل من الإعدادات أيضاً)
# WA_FEATURE_WA_BLOCK_BSUID=      # حظر من لا رقم ظاهراً له بمعرّفه
# WA_FEATURE_WA_BLOCK_ADMIN_TOOL= # أداة «احظر» للمساعد الإداري (معاينة ثم «تأكيد»)
# WA_BLOCK_NOTIFY=true            # إشعار المدراء بكل حظر (بلا رقم ولا اسم)
# WA_FEATURE_BUSINESS_PROFILE_SYNC=  # مزامنة ملف واتساب للأعمال مع بيانات الشركة
# WA_FEATURE_BUSINESS_PROFILE_PHOTO= # صورة الملف بالرفع القابل للاستئناف (يحتاج App ID)
# WA_FEATURE_ENTRY_TRACKING=      # تسجيل مصدر المحادثة (رمز أو رابط أو إعلان) ووسم موضوع العرض
# WA_FEATURE_WA_QR_LINKS=         # رموز QR وروابط قصيرة رسمية للعروض (message_qrdls)
# WA_FEATURE_OFFER_STORY_CARD=    # بطاقة حالة 9:16 للتنزيل والنشر اليدوي (لا نشر آلي)
# WA_MEDIA_HOST_MODE=log          # log أسبوعاً ثم enforce
# WA_MEDIA_HOSTS=fbsbx.com,whatsapp.net,facebook.com,fbcdn.net
# WA_FENCE_QUOTES=false           # طلبات التسعير بنطاق المحادثات
# OUTBOUND_HTTP_NO_REDIRECTS=true # لا يتبع أي نداء Http تحويلاً
# CHROMIUM_NET_ISOLATION=true     # بطاقات العروض بلا شبكة
# WA_FEATURE_DELIVERY_STATUS_V2=   # حالات التسليم الذرية وعلامات ✓✓ (E21؛ يُبدَّل من الإعدادات أيضاً)
# WA_FEATURE_WA_EVENT_BUS=          # مستمعو الأحداث الداخلية بدل إشعار التحويل والفشل المباشر (E21)
# WA_FEATURE_USER_PREFERENCES_OPTOUT= # إيقاف التسويق من تفضيلات واتساب إلى قائمة الرافضين (E21)
# WA_FEATURE_WA_LABELS=           # تصنيفات المحادثات وشارات النظام (E29؛ تُبدَّل من الإعدادات أيضاً)
# WA_FEATURE_THREAD_PINS=         # الملاحظة المثبتة الداخلية وبطاقة الحقائق
# WA_FEATURE_STAFF_TRANSLATION=   # الترجمة عند طلب الموظف (بعد تأكيد الطبقة المدفوعة لمزوّد الذكاء)
# WA_FEATURE_MESSAGE_SEARCH=      # البحث في نص الرسائل للمدراء (E30؛ يُبدَّل من الإعدادات أيضاً)
# WA_FEATURE_MESSAGE_SEARCH_ALL=  # البحث لكل موظفي الصندوق، بعد أسبوع من الأول
# WA_FEATURE_CONVERSATION_EXPORT= # تصدير محادثة واحدة لمن يملك whatsapp.export
# WA_FEATURE_READ_RECEIPTS=       # إشعار القراءة ومؤشر «يكتب…» (الوضع من الإعدادات)؛ false إطفاء فوري
# WA_TYPING_INDICATOR=true        # false إن رفض إصدار Graph المؤشر: يبقى إشعار القراءة عند رد الموظف وحده
# WA_FEATURE_AUTO_RULES=          # الردود الحتمية (الوضع ظل/فعلي من صفحتها)؛ false إطفاء فوري
# WA_FEATURE_CONVERSATIONAL_COMPONENTS= # مزامنة الأوامر وأسئلة البداية مع واتساب
# WA_FEATURE_INBOUND_SILENCE_ALERT= # تنبيه المدراء عند صمت الوارد في وقت الدوام
# OPS_INBOUND_SILENCE_MINUTES=180 # عتبة صمت الوارد بالدقائق (ساعات الدوام في config/ops.php)
# WA_FEATURE_INBOX_REALTIME=        # الصندوق اللحظي عبر Reverb، والاستطلاع احتياط (E28؛ يُبدَّل من الإعدادات أيضاً)
# WA_FEATURE_CONNECTION_RESILIENCE= # شريط الانقطاع وإعادة التحميل بعد النشر و«قد تكون أُرسلت» (E28)
# WA_SEND_PER_MINUTE=30             # حد إرسال الموظف في الدقيقة (الرد والسعر وطلب الرقم)، ثم «تمهّل قليلاً»
# WA_FEATURE_CHANNEL_HEALTH=        # صحة القناة كآلة حالات بدل الإيقاف الآلي القديم (E22؛ يُبدَّل من الإعدادات أيضاً)
# WA_FEATURE_CHANNEL_HEALTH_BLOCK_ON_TOKEN= # منع الإرسال عند رمز ميتا غير صالح (بقرار المالك بعد المراقبة)
# WA_FEATURE_INTEGRITY_BREAKER_LOCK= # قاطع النزاهة يحجب بدل أن ينبّه (بقرار المالك)
# WA_INTEGRITY_THRESHOLD=3          # تكرار 131031 أو 131048 خلال النافذة قبل التنبيه
# WA_INTEGRITY_WINDOW_MINUTES=15

# السجلات (E06): الإنتاج LOG_LEVEL=warning وLOG_STACK=daily (14 يوماً)، وأحداث الواتساب JSON في whatsapp-*.log
# LOG_LEVEL=warning
# LOG_STACK=daily
# LOG_DAILY_DAYS=14
# WA_LOG_LEVEL=info
# WA_LOG_DAYS=30

# الإقلاع في الإنتاج (docker/check-env.sh): APP_KEY إلزامي (نسخة في مدير كلمات المرور)، ولا APP_DEBUG.
# BOOT_GUARD=warn يحوّل الرفض إلى تحذير للطوارئ فقط.
# APP_PREVIOUS_KEYS=base64:...   # مفتاح سابق لفك ما شُفّر به بعد تدوير APP_KEY

# دورة حياة البيانات (E13): 0 = معطّل حتى يقرّر المالك (المقترح 730 مطابقةً لـ /privacy)، ويحتاج أيضاً العلم
# retention_purge من إعدادات الواتساب ونسخة ليلية ناجحة. مفتاح بصمة الرقم مستقل عن APP_KEY (يبقى عند تدويره)
# WA_RETENTION_DAYS=0
# WA_ADMIN_CHAT_RETENTION_DAYS=0
# ERASURE_HMAC_KEY=

# أرشيف مرفقات العملاء (E14): خلف العلم media_archive (مطفأ). الأنواع image,document افتراضياً.
# البصمة: log أسبوعاً ثم enforce. أنواع Office للتنزيل فقط بقرار المالك
# WA_MEDIA_DISK=wa_media
# WA_MEDIA_TYPES=image,document
# WA_MEDIA_RETENTION_DAYS=120
# WA_MEDIA_QUOTA_MB=5120
# WA_MEDIA_SHA_MODE=log
# WA_MEDIA_ALLOW_OFFICE=false
# WA_MEDIA_MIN_FREE_PCT=5         # أقل مساحة حرة على القرص (%) قبل أي تنزيل
# الملفات الصادرة (E32): المرفقات staff_file_send والفاتورة invoice_whatsapp_send وبطاقة العرض بالمعرّف
# offer_card_by_media_id والحذف من ميتا outbound_media_remote_delete، كلها مطفأة. الحدود بقرار المالك
# WA_OUTBOUND_MAX_DOCUMENT_MB=16  # حد PDF حتى 19 (كتلة nginx لمسار الإرسال 20m)
# WA_OUTBOUND_OFFICE_DOCS=false   # docx/xlsx/pptx/txt؛ doc/xls/ppt مرفوضة دائماً
# WA_OUTBOUND_VIDEO=true          # MP4 بترميز H.264 حتى 16MB
# WA_OUTBOUND_QUEUE_MAX_MINUTES=10 # ملف أقدم من هذا في الطابور لا يُرسل (1-14)
# WA_OUTBOUND_REMOTE_DELETE_TYPES=document
# WA_OUTBOUND_REMOTE_DELETE_STATUSES=read
# INVOICE_PDF_LETTERHEAD=true     # ورق الشركة الرسمي خلفية للفاتورة
# INVOICE_PDF_SHOW_TAX=false      # الرقم الضريبي في الفاتورة
# INVOICE_WHATSAPP_STATUSES=approved
# WA_FEATURE_STAFF_FILE_SEND=
# WA_FEATURE_INVOICE_WHATSAPP_SEND=
# WA_FEATURE_OFFER_CARD_BY_MEDIA_ID=
# WA_FEATURE_OUTBOUND_MEDIA_REMOTE_DELETE=
# رسائل الموظف الصوتية (E34): staff_voice_notes ثم staff_voice_transcript، مطفآن. ffmpeg في الصورة. «audio» في أنواع الحذف
# من ميتا بقرار المالك (مع played في الحالات)
# WA_VOICE_FFMPEG=/usr/bin/ffmpeg
# WA_VOICE_FFPROBE=/usr/bin/ffprobe
# WA_VOICE_MAX_SECONDS=120        # حد التسجيل (دقيقتان كي يبقى الملف تحت 512KB ويظهر زر التشغيل)
# WA_VOICE_BITRATE=32k            # يُعاد الترميز بـ 24k مرة إن تجاوز 512KB
# WA_FEATURE_STAFF_VOICE_NOTES=
# WA_FEATURE_STAFF_VOICE_TRANSCRIPT=
# بوابة المحتوى الصادر (E15.9): حسابات الشركة المسموح ذكرها في الرسائل الآلية، IBAN بلا مسافات مفصولة بفواصل
# WA_POLICY_ALLOW_IBANS=

# ترويسات الأمان والحاوية (E26). CSP_MODE: report (الافتراضي، تقارير بلا حجب) ثم الفرض بعد أسبوع نظيف بالعلم
# csp_enforce من إعدادات الواتساب أو CSP_MODE=enforce، وoff للطوارئ. مصادر اتصال إضافية بفواصل (Reverb على مضيف آخر)
# CSP_MODE=report
# CSP_CONNECT_EXTRA=
# WA_FEATURE_CSP_ENFORCE=
# في /opt/nuskJO/.env (تعويض compose): صلاحيات storage legacy حتى يُتحقق من ضم nginx إلى www-data ثم strict،
# وحدود الحاوية بعد القياس (scripts/security/measure-memory.sh)، و0 يرفع الحد في الطوارئ
# NUSKJO_STORAGE_PERMS=legacy
# NUSKJO_MEM_LIMIT=3g
# NUSKJO_PIDS_LIMIT=1024
# NUSKJO_CPUS=2.0
# بوابة تدقيق التبعيات في scripts/deploy.sh (بيئة الصدفة): warn أسبوع الخط الأساسي ثم enforce
# NUSKJO_AUDIT_GATE=warn

# التكاملات الصادرة وخادم MCP للقراءة (E40): العلمان يبدّلهما المدير وحده، ومطفآن. docs/integrations/
# WA_FEATURE_INTEGRATION_OUTBOX=
# WA_FEATURE_MCP_SERVER=
# INTEGRATIONS_ALLOWED_PORTS=       # منافذ غير 443 بفواصل (الافتراضي لا شيء)
# INTEGRATIONS_INTERNAL_ALLOW=      # استثناء داخلي واحد host:port (الموصى به الرابط العام بدله)
# INTEGRATIONS_SELF_HOSTS=          # مضيفاتنا غير مضيف APP_URL (لا وجهة تعود إلينا)
# MCP_CF_TEAM_DOMAIN=               # team.cloudflareaccess.com (بلا ضبط: /mcp/owner يرد 404 على الإنتاج)
# MCP_CF_AUD=                       # وسم AUD لتطبيق Cloudflare Access على /mcp/*
